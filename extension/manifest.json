{
  "manifest_version": 2,
  "name": "Sieve",
  "version": "0.1.0",
  "description": "Invisible cross-feed caliber filter and UI debloat for YouTube, Twitter, Instagram, and TikTok.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve@twarner491.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "*://*.youtube.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://dearrow.minibomba.pro/*"
  ],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Sieve",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles/youtube.css"],
      "js": ["dist/content-youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "css": ["styles/twitter.css"],
      "js": ["dist/content-twitter.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["styles/instagram.css"],
      "js": ["dist/content-instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["styles/tiktok.css"],
      "js": ["dist/content-tiktok.js"],
      "run_at": "document_start"
    }
  ]
}
